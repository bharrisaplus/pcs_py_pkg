[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
pillow = "*"
supports-color = "*"

[dev-packages]
flake8 = "*"
pylint = "*"
numpy = "*"
scipy = "*"

[requires]
python_version = "3.12"

[scripts]
specs_all = "python -m tool.test_runner -sbmw"
specs_behavior = "python -m tool.test_runner -b"
specs_metric = "python -m tool.test_runner -m"
specs_shape = "python -m tool.test_runner -s"
specs_widget = "python -m tool.test_runner -w"
specs_random = "python -m tool.test_runner -r"
cli_start = "python -m pcs.command_line"
cli_help = "python -m pcs.command_line -h"
